{%- comment -%}
  Loopy Video: shows a Loopy widget. Paste the widget ID from the Loopy admin (Get embed code).
  Every copy of this section keeps its own settings, and desktop and mobile are set separately.
  Generated by tools/build-theme-section.py in the Loopy repo; edit the table there.
{%- endcomment -%}

{%- liquid
  assign wid = section.settings.widget_id | strip
  assign pad = section.settings.padding_top
  assign pad_b = section.settings.padding_bottom
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .loopy-wrap {
    padding-top: calc({{ pad }}px * 0.75);
    padding-bottom: calc({{ pad_b }}px * 0.75);
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .loopy-wrap {
      padding-top: {{ pad }}px;
      padding-bottom: {{ pad_b }}px;
    }
  }
{%- endstyle -%}

<div class="loopy-wrap{% unless section.settings.full_width %} page-width{% endunless %}">
  {%- if wid != blank -%}
    <div
      data-tuco-video
      data-widget="{{ wid | escape }}"
      {%- if section.settings.heading != blank %} data-heading="{{ section.settings.heading | strip | escape }}"{% endif -%}
      {%- if section.settings.product_handle != blank %} data-product="{{ section.settings.product_handle | strip | escape }}"{% endif -%}
      {%- if section.settings.collection_handle != blank %} data-collection="{{ section.settings.collection_handle | strip | escape }}"{% endif -%}
      {%- if section.settings.page_handle != blank %} data-page="{{ section.settings.page_handle | strip | escape }}"{% endif -%}
      {%- if section.settings.banner_height_desktop > 0 %} data-banner-h-desktop="{{ section.settings.banner_height_desktop }}"{% endif -%}
      {%- if section.settings.banner_ratio_desktop != 'default' %} data-banner-ratio-desktop="{{ section.settings.banner_ratio_desktop }}"{% endif -%}
      {%- if section.settings.banner_radius_desktop != 'default' %} data-banner-radius-desktop="{{ section.settings.banner_radius_desktop }}"{% endif -%}
      {%- if section.settings.banner_margin_desktop != 'default' %} data-banner-margin-desktop="{{ section.settings.banner_margin_desktop }}"{% endif -%}
      {%- if section.settings.banner_max_desktop > 0 %} data-banner-max-desktop="{{ section.settings.banner_max_desktop }}"{% endif -%}
      {%- if section.settings.banner_height_mobile > 0 %} data-banner-h-mobile="{{ section.settings.banner_height_mobile }}"{% endif -%}
      {%- if section.settings.banner_ratio_mobile != 'default' %} data-banner-ratio-mobile="{{ section.settings.banner_ratio_mobile }}"{% endif -%}
      {%- if section.settings.banner_radius_mobile != 'default' %} data-banner-radius-mobile="{{ section.settings.banner_radius_mobile }}"{% endif -%}
      {%- if section.settings.banner_margin_mobile != 'default' %} data-banner-margin-mobile="{{ section.settings.banner_margin_mobile }}"{% endif -%}
      {%- if section.settings.banner_fit != 'default' %} data-banner-fit="{{ section.settings.banner_fit }}"{% endif -%}
      {%- if section.settings.banner_focus != 'default' %} data-banner-focus="{{ section.settings.banner_focus }}"{% endif -%}
      {%- if section.settings.tile_width_desktop > 0 %} data-tile-w-desktop="{{ section.settings.tile_width_desktop }}"{% endif -%}
      {%- if section.settings.tile_shape_desktop != 'default' %} data-tile-shape-desktop="{{ section.settings.tile_shape_desktop }}"{% endif -%}
      {%- if section.settings.tile_radius_desktop != 'default' %} data-tile-radius-desktop="{{ section.settings.tile_radius_desktop }}"{% endif -%}
      {%- if section.settings.tile_gap_desktop != 'default' %} data-tile-gap-desktop="{{ section.settings.tile_gap_desktop }}"{% endif -%}
      {%- if section.settings.tile_pad_desktop != 'default' %} data-tile-pad-desktop="{{ section.settings.tile_pad_desktop }}"{% endif -%}
      {%- if section.settings.tile_width_mobile > 0 %} data-tile-w-mobile="{{ section.settings.tile_width_mobile }}"{% endif -%}
      {%- if section.settings.tile_shape_mobile != 'default' %} data-tile-shape-mobile="{{ section.settings.tile_shape_mobile }}"{% endif -%}
      {%- if section.settings.tile_radius_mobile != 'default' %} data-tile-radius-mobile="{{ section.settings.tile_radius_mobile }}"{% endif -%}
      {%- if section.settings.tile_gap_mobile != 'default' %} data-tile-gap-mobile="{{ section.settings.tile_gap_mobile }}"{% endif -%}
      {%- if section.settings.tile_pad_mobile != 'default' %} data-tile-pad-mobile="{{ section.settings.tile_pad_mobile }}"{% endif -%}
      {%- if section.settings.tile_fit != 'default' %} data-tile-fit="{{ section.settings.tile_fit }}"{% endif -%}
      {%- if section.settings.story_size_desktop > 0 %} data-story-size-desktop="{{ section.settings.story_size_desktop }}"{% endif -%}
      {%- if section.settings.story_size_mobile > 0 %} data-story-size-mobile="{{ section.settings.story_size_mobile }}"{% endif -%}
      {%- if section.settings.story_shape != 'default' %} data-story-shape="{{ section.settings.story_shape }}"{% endif -%}
      {%- if section.settings.story_gap_desktop != 'default' %} data-story-gap-desktop="{{ section.settings.story_gap_desktop }}"{% endif -%}
      {%- if section.settings.story_gap_mobile != 'default' %} data-story-gap-mobile="{{ section.settings.story_gap_mobile }}"{% endif -%}
      {%- if section.settings.spot_width_desktop > 0 %} data-spot-w-desktop="{{ section.settings.spot_width_desktop }}"{% endif -%}
      {%- if section.settings.spot_width_mobile > 0 %} data-spot-w-mobile="{{ section.settings.spot_width_mobile }}"{% endif -%}
      {%- if section.settings.spot_radius_desktop != 'default' %} data-spot-radius-desktop="{{ section.settings.spot_radius_desktop }}"{% endif -%}
      {%- if section.settings.spot_radius_mobile != 'default' %} data-spot-radius-mobile="{{ section.settings.spot_radius_mobile }}"{% endif -%}
    ></div>
  {%- elsif request.design_mode -%}
    <p style="margin:0;padding:12px 16px;border:1px dashed #b0b0b0;border-radius:8px;font:13px/1.4 sans-serif;color:#555;text-align:center">
      Loopy Video: enter a widget ID in this section's settings (copy it from the Loopy admin, under Get embed code).
    </p>
  {%- endif -%}
</div>

{%- comment -%} Loads the Loopy script once per page, even with several of these sections. {%- endcomment -%}
<script>
  (function () {
    if (window.__tucoLoaded || document.querySelector('script[data-loopy]')) return;
    var s = document.createElement('script');
    s.src = 'https://loopy.tucokids.workers.dev/widget.js';
    s.defer = true;
    s.setAttribute('data-loopy', '');
    s.setAttribute('data-api', 'https://tuco-video-api.tucokids.workers.dev');
    document.head.appendChild(s);
  })();
</script>

