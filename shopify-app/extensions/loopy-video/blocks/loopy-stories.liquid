{%- comment -%}
  Loopy Stories app block: shows a Loopy widget. Paste the widget ID from the Loopy admin (Get embed code).
  Generated by tools/build-theme-section.py in the Loopy repo; edit the table there.
{%- endcomment -%}

{%- assign wid = block.settings.widget_id | strip -%}

<style>
  #loopy-block-{{ block.id }} { padding-top: calc({{ block.settings.padding_top }}px * 0.75); padding-bottom: calc({{ block.settings.padding_bottom }}px * 0.75); }
  @media screen and (min-width: 750px) { #loopy-block-{{ block.id }} { padding-top: {{ block.settings.padding_top }}px; padding-bottom: {{ block.settings.padding_bottom }}px; } }
</style>

<div id="loopy-block-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if wid != blank -%}
    <div
      data-tuco-video
      data-widget="{{ wid | escape }}"
      {%- if block.settings.heading != blank %} data-heading="{{ block.settings.heading | strip | escape }}"{% endif -%}
      {%- if block.settings.product_handle != blank %} data-product="{{ block.settings.product_handle | strip | escape }}"{% endif -%}
      {%- if block.settings.collection_handle != blank %} data-collection="{{ block.settings.collection_handle | strip | escape }}"{% endif -%}
      {%- if block.settings.page_handle != blank %} data-page="{{ block.settings.page_handle | strip | escape }}"{% endif -%}
      {%- if block.settings.story_size_desktop > 0 %} data-story-size-desktop="{{ block.settings.story_size_desktop }}"{% endif -%}
      {%- if block.settings.story_size_mobile > 0 %} data-story-size-mobile="{{ block.settings.story_size_mobile }}"{% endif -%}
      {%- if block.settings.story_shape != 'default' %} data-story-shape="{{ block.settings.story_shape }}"{% endif -%}
      {%- if block.settings.story_gap_desktop != 'default' %} data-story-gap-desktop="{{ block.settings.story_gap_desktop }}"{% endif -%}
      {%- if block.settings.story_gap_mobile != 'default' %} data-story-gap-mobile="{{ block.settings.story_gap_mobile }}"{% endif -%}
      {%- if block.settings.click_action != 'default' %} data-click-action="{{ block.settings.click_action }}"{% endif -%}
      {%- if block.settings.click_link != blank %} data-link="{{ block.settings.click_link | escape }}"{% endif -%}
      {%- if block.settings.click_target != 'default' %} data-link-target="{{ block.settings.click_target }}"{% endif -%}
      {%- if block.settings.brand_color != blank %} data-brand-color="{{ block.settings.brand_color | escape }}"{% endif -%}
      {%- if block.settings.font != blank %} data-font="{{ block.settings.font | escape }}"{% endif -%}
      {%- if block.settings.story_ring_color != blank %} data-story-ring-color="{{ block.settings.story_ring_color | escape }}"{% endif -%}
      {%- if block.settings.story_label_color != blank %} data-story-label-color="{{ block.settings.story_label_color | escape }}"{% endif -%}
    ></div>
  {%- elsif request.design_mode -%}
    <p style="margin:0;padding:12px 16px;border:1px dashed #b0b0b0;border-radius:8px;font:13px/1.4 sans-serif;color:#555;text-align:center">
      Loopy Stories: enter a widget ID in this block's settings (copy it from the Loopy admin, under Get embed code).
    </p>
  {%- endif -%}
</div>

<link rel="preconnect" href="https://tuco-video-api.tucokids.workers.dev" crossorigin>
<link rel="preconnect" href="https://loopy.tucokids.workers.dev" crossorigin>
<script>
  (function () {
    if (window.__tucoLoaded || document.querySelector('script[data-loopy]')) return;
    var s = document.createElement('script');
    s.src = 'https://loopy.tucokids.workers.dev/widget.js';
    s.defer = true;
    s.setAttribute('data-loopy', '');
    s.setAttribute('data-api', 'https://tuco-video-api.tucokids.workers.dev');
    document.head.appendChild(s);
  })();
</script>

{% schema %}
{
  "name": "Loopy Stories",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Round story circles that open a full-screen player. Everything below is optional except the widget ID. Leave a setting on Default to use what you set in Loopy."
    },
    {
      "type": "text",
      "id": "widget_id",
      "label": "Loopy widget ID",
      "info": "In Loopy open Widgets, pick your widget and copy its ID. It starts with wgt_"
    },
    {
      "type": "range",
      "id": "story_size_desktop",
      "label": "Desktop: Size",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Leave at 0 to use the default."
    },
    {
      "type": "range",
      "id": "story_size_mobile",
      "label": "Mobile: Size",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Leave at 0 to use the default."
    },
    {
      "type": "select",
      "id": "story_shape",
      "label": "Shape",
      "options": [
        {
          "value": "default",
          "label": "Default (set in Loopy)"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "rounded",
          "label": "Rounded square"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "story_gap_desktop",
      "label": "Desktop: Space between",
      "options": [
        {
          "value": "default",
          "label": "Default (set in Loopy)"
        },
        {
          "value": "0",
          "label": "0 px"
        },
        {
          "value": "4",
          "label": "4 px"
        },
        {
          "value": "8",
          "label": "8 px"
        },
        {
          "value": "12",
          "label": "12 px"
        },
        {
          "value": "16",
          "label": "16 px"
        },
        {
          "value": "24",
          "label": "24 px"
        },
        {
          "value": "32",
          "label": "32 px"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "story_gap_mobile",
      "label": "Mobile: Space between",
      "options": [
        {
          "value": "default",
          "label": "Default (set in Loopy)"
        },
        {
          "value": "0",
          "label": "0 px"
        },
        {
          "value": "4",
          "label": "4 px"
        },
        {
          "value": "8",
          "label": "8 px"
        },
        {
          "value": "12",
          "label": "12 px"
        },
        {
          "value": "16",
          "label": "16 px"
        },
        {
          "value": "24",
          "label": "24 px"
        },
        {
          "value": "32",
          "label": "32 px"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "click_action",
      "label": "When the video is clicked",
      "options": [
        {
          "value": "default",
          "label": "Default (set in Loopy)"
        },
        {
          "value": "player",
          "label": "Open the video player"
        },
        {
          "value": "none",
          "label": "Do nothing"
        }
      ],
      "default": "default",
      "info": "Default: carousels, stories and spotlights open the player, banners do nothing."
    },
    {
      "type": "text",
      "id": "click_link",
      "label": "Link when the video is clicked (optional)",
      "info": "Leave empty for the normal behaviour. Example: /collections/all or https://tucokids.com/pages/4-999"
    },
    {
      "type": "select",
      "id": "click_target",
      "label": "Open the link in",
      "options": [
        {
          "value": "default",
          "label": "Default (set in Loopy)"
        },
        {
          "value": "same",
          "label": "The same tab"
        },
        {
          "value": "new",
          "label": "A new tab"
        }
      ],
      "default": "default"
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Button and highlight colour",
      "info": "Leave empty to use the colour set in Loopy."
    },
    {
      "type": "text",
      "id": "font",
      "label": "Text font (optional)",
      "info": "A font name your theme already uses, for example Poppins. Leave empty for the default."
    },
    {
      "type": "color",
      "id": "story_ring_color",
      "label": "Circle border colour"
    },
    {
      "type": "color",
      "id": "story_label_color",
      "label": "Name colour under the circle"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space above",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space below",
      "default": 20
    }
  ]
}
{% endschema %}
