{%- comment -%}
  Loopy Product Tabs app block: shows a Loopy widget. Paste the widget ID from the Loopy admin (Get embed code).
  Generated by tools/build-theme-section.py in the Loopy repo; edit the table there.
{%- endcomment -%}

{%- assign wid = block.settings.widget_id | strip -%}
{%- liquid
  assign hpd = block.settings.hold_px_desktop | default: 0
  assign hpm = block.settings.hold_px_mobile | default: 0
  assign hold = false
  if hpd > 0 or hpm > 0
    assign hold = true
  endif
-%}


<style>
  #loopy-block-{{ block.id }} { padding-top: calc({{ block.settings.padding_top }}px * 0.75); padding-bottom: calc({{ block.settings.padding_bottom }}px * 0.75); }
  @media screen and (min-width: 750px) { #loopy-block-{{ block.id }} { padding-top: {{ block.settings.padding_top }}px; padding-bottom: {{ block.settings.padding_bottom }}px; } }
{% if hold %}
  #loopy-block-{{ block.id }} .loopy-hold { min-height: {{ hpm }}px; }
  @media screen and (min-width: 750px) { #loopy-block-{{ block.id }} .loopy-hold { min-height: {{ hpd }}px; } }
{% endif %}
</style>

<div id="loopy-block-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if wid != blank -%}
    <div
      data-tuco-video
      data-widget="{{ wid | escape }}"
      {%- if hold %} class="loopy-hold"{% endif -%}
      {%- if block.settings.heading != blank %} data-heading="{{ block.settings.heading | strip | escape }}"{% endif -%}
      {%- if block.settings.product_handle != blank %} data-product="{{ block.settings.product_handle | strip | escape }}"{% endif -%}
      {%- if block.settings.collection_handle != blank %} data-collection="{{ block.settings.collection_handle | strip | escape }}"{% endif -%}
      {%- if block.settings.page_handle != blank %} data-page="{{ block.settings.page_handle | strip | escape }}"{% endif -%}

    ><span hidden></span></div>
  {%- elsif request.design_mode -%}
    <p style="margin:0;padding:12px 16px;border:1px dashed #b0b0b0;border-radius:8px;font:13px/1.4 sans-serif;color:#555;text-align:center">
      Loopy Product Tabs: enter a widget ID in this block's settings (copy it from the Loopy admin, under Get embed code).
    </p>
  {%- endif -%}
</div>

<link rel="preconnect" href="https://tuco-video-api.tucokids.workers.dev" crossorigin>
<link rel="preconnect" href="https://loopy.tucokids.workers.dev" crossorigin>
<script>
  (function () {
    if (window.__tucoLoaded || document.querySelector('script[data-loopy]')) return;
    var s = document.createElement('script');
    s.src = 'https://loopy.tucokids.workers.dev/widget.js';
    s.defer = true;
    s.setAttribute('data-loopy', '');
    s.setAttribute('data-api', 'https://tuco-video-api.tucokids.workers.dev');
    document.head.appendChild(s);
  })();
</script>

{% schema %}
{
  "name": "Loopy Product Tabs",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Category tabs, each with a video first and then product cards with price, rating and add to cart. The tabs, products, texts and colours are all set in Loopy. Everything below is optional except the widget ID. Leave a setting on Default to use what you set in Loopy."
    },
    {
      "type": "text",
      "id": "widget_id",
      "label": "Loopy widget ID",
      "info": "In Loopy open Widgets, pick your widget and copy its ID. It starts with wgt_"
    },
    {
      "type": "range",
      "id": "hold_px_desktop",
      "min": 0,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Desktop: Space to keep while loading",
      "default": 720,
      "info": "Keeps an empty space this tall until the section appears, so the page below does not jump. Set to 0 to keep none."
    },
    {
      "type": "range",
      "id": "hold_px_mobile",
      "min": 0,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Mobile: Space to keep while loading",
      "default": 560,
      "info": "Same, for phones."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space above",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space below",
      "default": 20
    }
  ]
}
{% endschema %}
