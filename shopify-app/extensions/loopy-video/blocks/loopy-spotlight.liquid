{%- comment -%}
  Loopy Spotlight app block: shows a Loopy widget. Paste the widget ID from the Loopy admin (Get embed code).
  Generated by tools/build-theme-section.py in the Loopy repo; edit the table there.
{%- endcomment -%}

{%- assign wid = block.settings.widget_id | strip -%}

<style>
  #loopy-block-{{ block.id }} { padding-top: calc({{ block.settings.padding_top }}px * 0.75); padding-bottom: calc({{ block.settings.padding_bottom }}px * 0.75); }
  @media screen and (min-width: 750px) { #loopy-block-{{ block.id }} { padding-top: {{ block.settings.padding_top }}px; padding-bottom: {{ block.settings.padding_bottom }}px; } }
</style>

<div id="loopy-block-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if wid != blank -%}
    <div
      data-tuco-video
      data-widget="{{ wid | escape }}"
      {%- if block.settings.heading != blank %} data-heading="{{ block.settings.heading | strip | escape }}"{% endif -%}
      {%- if block.settings.product_handle != blank %} data-product="{{ block.settings.product_handle | strip | escape }}"{% endif -%}
      {%- if block.settings.collection_handle != blank %} data-collection="{{ block.settings.collection_handle | strip | escape }}"{% endif -%}
      {%- if block.settings.page_handle != blank %} data-page="{{ block.settings.page_handle | strip | escape }}"{% endif -%}
      {%- if block.settings.spot_width_desktop > 0 %} data-spot-w-desktop="{{ block.settings.spot_width_desktop }}"{% endif -%}
      {%- if block.settings.spot_width_mobile > 0 %} data-spot-w-mobile="{{ block.settings.spot_width_mobile }}"{% endif -%}
      {%- if block.settings.spot_radius_desktop != 'default' %} data-spot-radius-desktop="{{ block.settings.spot_radius_desktop }}"{% endif -%}
      {%- if block.settings.spot_radius_mobile != 'default' %} data-spot-radius-mobile="{{ block.settings.spot_radius_mobile }}"{% endif -%}
      {%- if block.settings.brand_color != blank %} data-brand-color="{{ block.settings.brand_color | escape }}"{% endif -%}
      {%- if block.settings.font != blank %} data-font="{{ block.settings.font | escape }}"{% endif -%}
      {%- if block.settings.button_text != blank %} data-button-text="{{ block.settings.button_text | escape }}"{% endif -%}
    ></div>
  {%- elsif request.design_mode -%}
    <p style="margin:0;padding:12px 16px;border:1px dashed #b0b0b0;border-radius:8px;font:13px/1.4 sans-serif;color:#555;text-align:center">
      Loopy Spotlight: enter a widget ID in this block's settings (copy it from the Loopy admin, under Get embed code).
    </p>
  {%- endif -%}
</div>

<script>
  (function () {
    if (window.__tucoLoaded || document.querySelector('script[data-loopy]')) return;
    var s = document.createElement('script');
    s.src = 'https://loopy.tucokids.workers.dev/widget.js';
    s.defer = true;
    s.setAttribute('data-loopy', '');
    s.setAttribute('data-api', 'https://tuco-video-api.tucokids.workers.dev');
    document.head.appendChild(s);
  })();
</script>

{% schema %}
{
  "name": "Loopy Spotlight",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Small floating video in the corner of the page. Copy the widget ID from Loopy (widget page, then Get embed code)."
    },
    {
      "type": "text",
      "id": "widget_id",
      "label": "Loopy widget ID",
      "info": "Looks like wgt_ab12cd34"
    },
    {
      "type": "range",
      "id": "spot_width_desktop",
      "label": "Spotlight and floating video: Width on desktop",
      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "0 uses the Loopy setting."
    },
    {
      "type": "range",
      "id": "spot_width_mobile",
      "label": "Spotlight and floating video: Width on mobile",
      "min": 0,
      "max": 220,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "0 uses the Loopy setting."
    },
    {
      "type": "select",
      "id": "spot_radius_desktop",
      "label": "Spotlight and floating video: Corners on desktop",
      "options": [
        {
          "value": "default",
          "label": "Use the Loopy setting"
        },
        {
          "value": "0",
          "label": "Square"
        },
        {
          "value": "8",
          "label": "Slightly rounded"
        },
        {
          "value": "16",
          "label": "Rounded"
        },
        {
          "value": "28",
          "label": "Very rounded"
        },
        {
          "value": "999",
          "label": "Pill / circle"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "spot_radius_mobile",
      "label": "Spotlight and floating video: Corners on mobile",
      "options": [
        {
          "value": "default",
          "label": "Use the Loopy setting"
        },
        {
          "value": "0",
          "label": "Square"
        },
        {
          "value": "8",
          "label": "Slightly rounded"
        },
        {
          "value": "16",
          "label": "Rounded"
        },
        {
          "value": "28",
          "label": "Very rounded"
        },
        {
          "value": "999",
          "label": "Pill / circle"
        }
      ],
      "default": "default"
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Button and highlight colour"
    },
    {
      "type": "text",
      "id": "font",
      "label": "Font name",
      "info": "A font your theme already loads, for example Poppins. Empty uses the Loopy setting."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "info": "For example Shop now. Empty uses the Loopy setting."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    }
  ]
}
{% endschema %}
