{%- comment -%}
  Loopy Video app block: shows a Loopy widget. Paste the widget ID from the Loopy admin (Get embed code).
  Generated by tools/build-theme-section.py in the Loopy repo; edit the table there.
{%- endcomment -%}

{%- assign wid = block.settings.widget_id | strip -%}

<style>
  #loopy-block-{{ block.id }} { padding-top: calc({{ block.settings.padding_top }}px * 0.75); padding-bottom: calc({{ block.settings.padding_bottom }}px * 0.75); }
  @media screen and (min-width: 750px) { #loopy-block-{{ block.id }} { padding-top: {{ block.settings.padding_top }}px; padding-bottom: {{ block.settings.padding_bottom }}px; } }
</style>

<div id="loopy-block-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if wid != blank -%}
    <div
      data-tuco-video
      data-widget="{{ wid | escape }}"
      {%- if block.settings.heading != blank %} data-heading="{{ block.settings.heading | strip | escape }}"{% endif -%}
      {%- if block.settings.product_handle != blank %} data-product="{{ block.settings.product_handle | strip | escape }}"{% endif -%}
      {%- if block.settings.collection_handle != blank %} data-collection="{{ block.settings.collection_handle | strip | escape }}"{% endif -%}
      {%- if block.settings.page_handle != blank %} data-page="{{ block.settings.page_handle | strip | escape }}"{% endif -%}
      {%- if block.settings.banner_height_desktop > 0 %} data-banner-h-desktop="{{ block.settings.banner_height_desktop }}"{% endif -%}
      {%- if block.settings.banner_ratio_desktop != 'default' %} data-banner-ratio-desktop="{{ block.settings.banner_ratio_desktop }}"{% endif -%}
      {%- if block.settings.banner_radius_desktop != 'default' %} data-banner-radius-desktop="{{ block.settings.banner_radius_desktop }}"{% endif -%}
      {%- if block.settings.banner_margin_desktop != 'default' %} data-banner-margin-desktop="{{ block.settings.banner_margin_desktop }}"{% endif -%}
      {%- if block.settings.banner_max_desktop > 0 %} data-banner-max-desktop="{{ block.settings.banner_max_desktop }}"{% endif -%}
      {%- if block.settings.banner_height_mobile > 0 %} data-banner-h-mobile="{{ block.settings.banner_height_mobile }}"{% endif -%}
      {%- if block.settings.banner_ratio_mobile != 'default' %} data-banner-ratio-mobile="{{ block.settings.banner_ratio_mobile }}"{% endif -%}
      {%- if block.settings.banner_radius_mobile != 'default' %} data-banner-radius-mobile="{{ block.settings.banner_radius_mobile }}"{% endif -%}
      {%- if block.settings.banner_margin_mobile != 'default' %} data-banner-margin-mobile="{{ block.settings.banner_margin_mobile }}"{% endif -%}
      {%- if block.settings.banner_fit != 'default' %} data-banner-fit="{{ block.settings.banner_fit }}"{% endif -%}
      {%- if block.settings.banner_focus != 'default' %} data-banner-focus="{{ block.settings.banner_focus }}"{% endif -%}
      {%- if block.settings.tile_width_desktop > 0 %} data-tile-w-desktop="{{ block.settings.tile_width_desktop }}"{% endif -%}
      {%- if block.settings.tile_shape_desktop != 'default' %} data-tile-shape-desktop="{{ block.settings.tile_shape_desktop }}"{% endif -%}
      {%- if block.settings.tile_radius_desktop != 'default' %} data-tile-radius-desktop="{{ block.settings.tile_radius_desktop }}"{% endif -%}
      {%- if block.settings.tile_gap_desktop != 'default' %} data-tile-gap-desktop="{{ block.settings.tile_gap_desktop }}"{% endif -%}
      {%- if block.settings.tile_pad_desktop != 'default' %} data-tile-pad-desktop="{{ block.settings.tile_pad_desktop }}"{% endif -%}
      {%- if block.settings.tile_width_mobile > 0 %} data-tile-w-mobile="{{ block.settings.tile_width_mobile }}"{% endif -%}
      {%- if block.settings.tile_shape_mobile != 'default' %} data-tile-shape-mobile="{{ block.settings.tile_shape_mobile }}"{% endif -%}
      {%- if block.settings.tile_radius_mobile != 'default' %} data-tile-radius-mobile="{{ block.settings.tile_radius_mobile }}"{% endif -%}
      {%- if block.settings.tile_gap_mobile != 'default' %} data-tile-gap-mobile="{{ block.settings.tile_gap_mobile }}"{% endif -%}
      {%- if block.settings.tile_pad_mobile != 'default' %} data-tile-pad-mobile="{{ block.settings.tile_pad_mobile }}"{% endif -%}
      {%- if block.settings.tile_fit != 'default' %} data-tile-fit="{{ block.settings.tile_fit }}"{% endif -%}
      {%- if block.settings.story_size_desktop > 0 %} data-story-size-desktop="{{ block.settings.story_size_desktop }}"{% endif -%}
      {%- if block.settings.story_size_mobile > 0 %} data-story-size-mobile="{{ block.settings.story_size_mobile }}"{% endif -%}
      {%- if block.settings.story_shape != 'default' %} data-story-shape="{{ block.settings.story_shape }}"{% endif -%}
      {%- if block.settings.story_gap_desktop != 'default' %} data-story-gap-desktop="{{ block.settings.story_gap_desktop }}"{% endif -%}
      {%- if block.settings.story_gap_mobile != 'default' %} data-story-gap-mobile="{{ block.settings.story_gap_mobile }}"{% endif -%}
      {%- if block.settings.spot_width_desktop > 0 %} data-spot-w-desktop="{{ block.settings.spot_width_desktop }}"{% endif -%}
      {%- if block.settings.spot_width_mobile > 0 %} data-spot-w-mobile="{{ block.settings.spot_width_mobile }}"{% endif -%}
      {%- if block.settings.spot_radius_desktop != 'default' %} data-spot-radius-desktop="{{ block.settings.spot_radius_desktop }}"{% endif -%}
      {%- if block.settings.spot_radius_mobile != 'default' %} data-spot-radius-mobile="{{ block.settings.spot_radius_mobile }}"{% endif -%}
    ></div>
  {%- elsif request.design_mode -%}
    <p style="margin:0;padding:12px 16px;border:1px dashed #b0b0b0;border-radius:8px;font:13px/1.4 sans-serif;color:#555;text-align:center">
      Loopy Video: enter a widget ID in this block's settings (copy it from the Loopy admin, under Get embed code).
    </p>
  {%- endif -%}
</div>

<script>
  (function () {
    if (window.__tucoLoaded || document.querySelector('script[data-loopy]')) return;
    var s = document.createElement('script');
    s.src = 'https://loopy.tucokids.workers.dev/widget.js';
    s.defer = true;
    s.setAttribute('data-loopy', '');
    s.setAttribute('data-api', 'https://tuco-video-api.tucokids.workers.dev');
    document.head.appendChild(s);
  })();
</script>

